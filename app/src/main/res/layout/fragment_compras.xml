<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" app:tabMode="fixed" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPedidos" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="12dp" />
        <TextView
            android:id="@+id/tvVacio" style="@style/TxtCuerpo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="@string/t_no_tienes_compras_en_esta_seccio" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
