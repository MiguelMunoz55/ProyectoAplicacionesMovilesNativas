<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/tvSaludo" style="@style/TxtTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView style="@style/TarjetaSpec" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="4dp" android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/TxtCuerpo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t_ventas_del_mes" android:textSize="12sp" />
                    <TextView android:id="@+id/tvVentasMes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/azul_spechub" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/TarjetaSpec" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="4dp" android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView style="@style/TxtCuerpo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t_pedidos_nuevos" android:textSize="12sp" />
                    <TextView android:id="@+id/tvPedidosNuevos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/ambar_texto" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/TarjetaSpec" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView style="@style/TxtSubtitulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t_ventas_ultimos_7_dias" android:textSize="14sp" />
                <co.edu.ucompensar.spechub.ui.comun.GraficoBarrasView android:id="@+id/grafico" android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/TxtSubtitulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:layout_marginTop="16dp" android:text="@string/t_stock_bajo" />
        <LinearLayout android:id="@+id/llStockBajo" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/tvSinStockBajo" style="@style/TxtCuerpo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="4dp" android:text="@string/t_todo_tu_inventario_esta_al_dia" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
