<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/azul_noche" app:title="@string/t_direccion_de_entrega" app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_atras" app:navigationIconTint="@color/white" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="160dp" android:background="@drawable/bg_imagen">
                <ImageView
                    android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:importantForAccessibility="no"
                    android:src="@drawable/ic_ubicacion" app:tint="@color/rojo" />
                <TextView
                    style="@style/TxtCuerpo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp" android:text="@string/t_vista_de_mapa_google_maps_sdk_pe" android:textSize="11sp" />
            </FrameLayout>
            <TextView style="@style/TxtSubtitulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/t_ubicacion_detectada" />
            <TextView android:id="@+id/tvUbicacion" style="@style/TxtCuerpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/t_aun_no_detectada" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCalle" style="@style/CampoTexto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/t_direccion_calle_carrera_numero" >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCalle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPostalAddress"  />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCiudad" style="@style/CampoTexto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/t_ciudad" >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCiudad" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapWords"  />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilReferencia" style="@style/CampoTexto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/t_apto_torre_referencias" >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReferencia" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text"  />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUbicacion" style="@style/BtnContorno" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/t_usar_mi_ubicacion_actual" app:icon="@drawable/ic_ubicacion" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar" style="@style/BtnPrimario" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/t_guardar_direccion" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
