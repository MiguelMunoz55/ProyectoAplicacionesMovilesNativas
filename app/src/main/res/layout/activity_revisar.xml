<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/azul_noche" app:title="@string/t_revisar_producto" app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_atras" app:navigationIconTint="@color/white" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <ImageView android:id="@+id/ivImagen" android:layout_width="120dp" android:layout_height="120dp" android:background="@drawable/bg_imagen" android:contentDescription="@string/t_imagen_del_producto" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvTitulo" style="@style/TxtSubtitulo" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvVendedor" style="@style/TxtCuerpo" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvPrecio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/azul_spechub" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvEstado" style="@style/TxtPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/tvFicha" style="@style/TxtCuerpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="4dp" />
            <TextView style="@style/TxtSubtitulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/t_lista_de_verificacion" />
            <CheckBox android:id="@+id/cbFotos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/t_fotos_claras_y_propias" />
            <CheckBox android:id="@+id/cbSpecs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/t_especificaciones_completas" />
            <CheckBox android:id="@+id/cbImei" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/t_imei_serial_valido" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMotivo" style="@style/CampoTexto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/t_motivo_obligatorio_si_se_rechaza" >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMotivo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text|textCapSentences"  />
        </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAprobar" style="@style/BtnExito" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="@string/t_aprobar" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRechazar" style="@style/BtnPeligro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:text="@string/t_rechazar" />
            </LinearLayout>
            <TextView style="@style/TxtCuerpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/t_la_decision_queda_en_el_registro" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
