<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/azul_noche" app:title="@string/t_detalle_del_producto" app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_atras" app:navigationIconTint="@color/white" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView
                android:id="@+id/ivImagen" android:layout_width="match_parent" android:layout_height="240dp"
                android:background="@color/azul_claro" android:contentDescription="@string/t_imagen_del_producto" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvTitulo" style="@style/TxtTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tvPrecio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textColor="@color/azul_spechub" android:textSize="26sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvCondicion" style="@style/TxtPill" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
                <TextView
                    style="@style/TxtSubtitulo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/t_especificaciones" />
                <LinearLayout android:id="@+id/llSpecs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView
                    android:id="@+id/tvDescripcion" style="@style/TxtCuerpo" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
                <TextView
                    android:id="@+id/tvVendedor" style="@style/TxtSubtitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white"
        android:elevation="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenos" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="44dp"
            android:layout_height="44dp" android:insetLeft="0dp" android:insetRight="0dp" android:padding="0dp"
            android:contentDescription="@string/t_quitar_una_unidad" android:text="@string/t_txt" />
        <TextView
            android:id="@+id/tvCantidad" style="@style/TxtSubtitulo" android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMas" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="44dp"
            android:layout_height="44dp" android:insetLeft="0dp" android:insetRight="0dp" android:padding="0dp"
            android:contentDescription="@string/t_agregar_una_unidad" android:text="@string/t_txt_2" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregar" style="@style/BtnContorno" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/t_agregar" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComprar" style="@style/BtnPrimario" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/t_comprar" />
    </LinearLayout>
</LinearLayout>
