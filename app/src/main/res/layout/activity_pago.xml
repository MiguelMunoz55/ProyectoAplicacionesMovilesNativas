<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/azul_noche" app:title="@string/t_pago_seguro" app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_atras" app:navigationIconTint="@color/white" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t_envio" android:textColor="@color/verde_texto" android:textStyle="bold" />
                <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="@color/azul_spechub" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t_2_pago" android:textColor="@color/azul_spechub" android:textStyle="bold" />
                <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="@color/borde" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t_3_confirmar" android:textColor="@color/texto_secundario" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                style="@style/TarjetaSpec" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" app:cardBackgroundColor="@color/azul_claro">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/tvPedido" style="@style/TxtCuerpo" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                        <TextView style="@style/TxtSubtitulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/t_total_a_pagar" />
                        <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:textColor="@color/azul_spechub" android:textSize="20sp" android:textStyle="bold" />
                    </RelativeLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
                        <TextView android:id="@+id/tvDireccion" style="@style/TxtCuerpo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCambiarDireccion" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/t_cambiar" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <RadioGroup android:id="@+id/rgMedios" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <RadioButton android:id="@+id/rbTarjeta" android:layout_width="match_parent" android:layout_height="48dp" android:checked="true" android:text="@string/t_tarjeta_credito_debito" />
                <RadioButton android:id="@+id/rbPse" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/t_pse" />
                <RadioButton android:id="@+id/rbNequi" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/t_nequi" />
                <RadioButton android:id="@+id/rbBancolombia" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/t_bancolombia" />
            </RadioGroup>
            <LinearLayout android:id="@+id/llTarjeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNumero" style="@style/CampoTexto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/t_numero_de_tarjeta" >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNumero" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:maxLength="19" />
        </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilVence" style="@style/CampoTexto" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp" android:layout_weight="1" android:hint="@string/t_vence_mm_aa">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVence" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCvv" style="@style/CampoTexto" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:layout_weight="1" android:hint="@string/t_cvv" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCvv" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberPassword" android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                style="@style/TxtCuerpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/t_pago_simulado_en_esta_version_en" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progreso" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPagar" style="@style/BtnExito" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:text="@string/t_pagar" />
</LinearLayout>
